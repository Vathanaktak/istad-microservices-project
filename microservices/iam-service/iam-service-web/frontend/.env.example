# Public OAuth2 client registered in the IAM authorization server (see ClientSeeder)
VITE_CLIENT_ID=iam-web
# Leave empty when the SPA is served by iam-service or via the Vite dev proxy
VITE_API_BASE=
# Pages whose REST endpoints don't exist yet fall back to demo data (shows a "Demo data" badge). Set false to disable.
VITE_DEMO_FALLBACK=true
# Where the Vite dev proxy forwards /api, /oauth2, /login, /logout, ... (default http://localhost:9000)
IAM_BACKEND_URL=http://localhost:9000
