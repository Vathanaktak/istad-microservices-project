# =============================================================================
# Microservice IAM-Service Git Ignore
# =============================================================================

# --- Environment & Secret Files ---
.env
.env.local
.env.*.local
*.env
# Keep example/template files
!.env.example
!.env.*.example
!*.env.example

# Certificates & Private Keys
*.pem
*.key
*.jks
*.p12
*.pfx
*.keystore

# --- Gradle Build Output & Cache ---
.gradle/
build/
*/build/
**/build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# --- Node.js & Frontend Artifacts (React / Vite) ---
node_modules/
*/node_modules/
**/node_modules/
dist/
*/dist/
**/dist/
.eslintcache
.stylelintcache
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Defunct / Legacy Web Artifacts ---
iam-web/

# --- IDE and Editor Specific Files ---
.idea/
*.iml
*.iws
*.ipr
out/
**/out/
.vscode/
*.swp
*.swo
*~

# Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/
**/bin/

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Logs & Diagnostics ---
logs/
**/logs/
*.log
*.tmp
*.temp

# --- Test & Coverage Reports ---
coverage/
.nyc_output/
