# --- required
DB_URL=jdbc:postgresql://localhost:5432/iam_db
DB_USERNAME=postgres
DB_PASSWORD=your_password
IAM_DCR_CLIENT_SECRET=your_client_secret

# --- optional: first administrator (created at startup if absent)
IAM_ADMIN_USERNAME=admin
IAM_ADMIN_EMAIL=admin@example.com
IAM_ADMIN_PASSWORD=your_admin_password

# --- optional
IAM_ISSUER=http://localhost:8080

# OAuth2 / Social Login
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_telegram_bot_username
