{
  "info": {
    "name": "ISTAD IAM Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run 'Token (authorization_code)' (or paste a token) to set {{token}}. Admin APIs need the ADMIN role."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userUuid",
      "value": ""
    },
    {
      "key": "roleUuid",
      "value": ""
    },
    {
      "key": "permissionUuid",
      "value": ""
    },
    {
      "key": "identityUuid",
      "value": ""
    },
    {
      "key": "dcrClientSecret",
      "value": ""
    },
    {
      "key": "initialAccessToken",
      "value": ""
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "clientSecret",
      "value": ""
    },
    {
      "key": "registrationAccessToken",
      "value": ""
    },
    {
      "key": "codeVerifier",
      "value": ""
    },
    {
      "key": "codeChallenge",
      "value": ""
    },
    {
      "key": "authCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "OAuth2 / OIDC / DCR",
      "item": [
        {
          "name": "Discovery",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/.well-known/openid-configuration",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Initial access token (client_credentials, scope client.create)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "iam-dcr-initial"
                },
                {
                  "key": "password",
                  "value": "{{dcrClientSecret}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "scope",
                  "value": "client.create"
                }
              ]
            },
            "url": "{{baseUrl}}/oauth2/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('initialAccessToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Dynamic Client Registration",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{initialAccessToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_name\": \"ISTAD E-Commerce Web\",\n  \"redirect_uris\": [\n    \"http://localhost:8081/login/oauth2/code/iam\"\n  ],\n  \"grant_types\": [\n    \"authorization_code\",\n    \"refresh_token\"\n  ],\n  \"response_types\": [\n    \"code\"\n  ],\n  \"scope\": \"openid profile email\",\n  \"token_endpoint_auth_method\": \"client_secret_basic\"\n}"
            },
            "url": "{{baseUrl}}/connect/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j=pm.response.json(); pm.collectionVariables.set('clientId', j.client_id); pm.collectionVariables.set('clientSecret', j.client_secret); pm.collectionVariables.set('registrationAccessToken', j.registration_access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read registered client",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{registrationAccessToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/connect/register?client_id={{clientId}}"
          }
        },
        {
          "name": "Authorize (open in browser)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/oauth2/authorize?response_type=code&client_id={{clientId}}&scope=openid profile email&redirect_uri=http://localhost:8081/login/oauth2/code/iam&code_challenge={{codeChallenge}}&code_challenge_method=S256"
          }
        },
        {
          "name": "Token (authorization_code)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{clientId}}"
                },
                {
                  "key": "password",
                  "value": "{{clientSecret}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "code",
                  "value": "{{authCode}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "http://localhost:8081/login/oauth2/code/iam"
                },
                {
                  "key": "code_verifier",
                  "value": "{{codeVerifier}}"
                }
              ]
            },
            "url": "{{baseUrl}}/oauth2/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "UserInfo",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/userinfo"
          }
        }
      ]
    },
